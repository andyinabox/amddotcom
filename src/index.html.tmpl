<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{ .SiteData.Title }}</title>
    <meta name="description" content="{{ .Pages.BioMD.Text }}" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="stylesheet" href="/styles.css" />
    <style>
      :root {
        --amd-font-size-bio-xs: {{ .SiteData.BioFontSizeXs }};
        --amd-font-size-bio-sm: {{ .SiteData.BioFontSizeSm }};
        --amd-font-size-bio-md: {{ .SiteData.BioFontSizeMd }};
        --amd-font-size-bio-lg: {{ .SiteData.BioFontSizeLg }};
        --amd-font-size-bio-xl: {{ .SiteData.BioFontSizeXl }};
      }
    </style>
  </head>
  <body>

    <header class="header-main">
      <label class="btn btn-more" id="btn-less" for="slider">Less</label>
      <input class="slider" id="slider" type="range" value="3" min="1" max="5" step="0.01" />
      <label class="btn btn-less" id="btn-more" for="slider">More</label>
    </header>

    <main>
      <section class="bio-container bio-md" id="bio-container">{{ .Pages.BioMD.HTML }}</section>
    </main>

    {{/* <time id="publish-date" class="publish-date" datetime="{{ .BuildData.Time }}">{{ .BuildData.TimeFormatted }}</time> */}}

    <time id="publish-date" class="publish-date" datetime="2024-12-03T22:45:10+01:00">December 3, 2023</time>


    <!-- templates -->
    <template id="tmpl-bio-xs">{{ .Pages.BioXS.HTML }}</template>
    <template id="tmpl-bio-sm">{{ .Pages.BioSM.HTML }}</template>
    <template id="tmpl-bio-md">{{ .Pages.BioMD.HTML }}</template>
    <template id="tmpl-bio-lg">{{ .Pages.BioLG.HTML }}</template>
    <template id="tmpl-bio-xl">{{ .Pages.BioXL.HTML }}</template>

    <script src="/script.js"></script>
  </body>
</html>
